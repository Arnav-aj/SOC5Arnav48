#include <iostream>
using namespace std;

class Calculator
{
	private:
	int num;

	public:
	
	int add(int a, int b)
	{
	return a+b;
	}

	int add(int a, int b, int c)
	{
	return a+b+c;
	}
};

	int main()
{
	Calculator c;
	cout<<"Addition of a and b is:"<<c.add(3,5)<<endl;
	cout<<"Addition of a and b and c is:"<<c.add(5,7,8)<<endl;
	return 0;
}
